# Copy to an ignored .env file and export before running Go.
DATABASE_URL=postgres://mind_offline:REPLACE_ME@127.0.0.1:5432/mind_offline?sslmode=disable
# Existing cole account ID; leave empty to disable all administrator access.
ADMIN_ACCOUNT_ID=
LISTEN_ADDR=127.0.0.1:18082

# Optional experimental NetEase connection. Keep real values out of Git.
# NCM_BRIDGE_URL=http://127.0.0.1:18085
# NCM_BRIDGE_TOKEN=<random secret, at least 32 characters>
# MUSIC_ENCRYPTION_KEY=<base64 of 32 cryptographically random bytes>

# Optional task email reminders. Store the actual QQ authorization code only on the server.
# MAIL_FROM=coleliu888@qq.com
# QQ_SMTP_AUTH_CODE=<QQ mailbox SMTP authorization code>
